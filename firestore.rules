rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CRITICAL: Emergency override for admin emails
    function isSuperAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "adprofessionalsolution@gmail.com" || 
              request.auth.token.email.lower() == "anuscyberwork@gmail.com");
    }

    match /users/{userId} {
      allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /tenders/{tenderId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /{path=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
